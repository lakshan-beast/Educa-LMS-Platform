import React, { useState, useEffect } from "react";
import { db } from "../firebase/config";
import { collection, query, onSnapshot } from "firebase/firestore";
import { FaClock, FaLocationDot, FaFolderOpen, FaGraduationCap } from "react-icons/fa6";

const ClassScheduleAdmin = () => {
  const [schedules, setSchedules] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    const q = query(collection(db, "class_schedules"));

    const unsubscribe = onSnapshot(q, (snapshot) => {
      const scheduleList = snapshot.docs.map((doc) => ({
        id: doc.id,
        ...doc.data()
      }));
      setSchedules(scheduleList);
      setIsLoading(false);
    }, (err) => {
      console.error("Public Schedule Cloud Fetch Error:", err);
      setIsLoading(false);
    });

    return () => unsubscribe();
  }, []);

  if (isLoading) {
    return <div className="schedule-loading">🔄 Streaming Live Cloud Timetables...</div>;
  }

  if (schedules.length === 0) {
    return (
      <div className="schedule-empty">
        <FaFolderOpen className="empty-icon" />
        <p>No active class timetables published at the moment.</p>
      </div>
    );
  }

  return (
    <div className="schedule-grid">
      {schedules.map((item) => (
        <div key={item.id} className="schedule-card">
          <div className="schedule-card-badge">
            <FaGraduationCap /> <span>{item.grade || "Grade 6-11"}</span>
          </div>
          <h4>{item.subjectName || item.title}</h4>
          <div className="meta-row">
            <FaClock /> <span>{item.classTime || "04:00 PM - 06:00 PM"}</span>
          </div>
          <div className="meta-row">
            <FaLocationDot /> <span>{item.classDay  "Weekly Session"} ({item.medium  "Sinhala"})</span>
          </div>
        </div>
      ))}
    </div>
  );
};

export default ClassScheduleAdmin;