
import React from "react"; import { Link } from "react-router-dom"; import { FaCalendarCheck, FaBullhorn, FaGoogle, FaLock } from "react-icons/fa6"; const ScheduleCard = ({ cls, isLive, isPaused, isClosed, calculateCountdown, buildGoogleCalendarUrl, latestNotice }) => { return ( <div disabled={isClosed || isPaused} className={public-schedule-card ${isLive ? "pulse-neon-live" : isPaused ? "card-postponed" : isClosed ? "card-session-ended" : "card-upcoming"}} > {/* CARD TOP META BAR */} <div className="card-top-bar-meta"> <span className={status-tag-pill ${isLive ? "live" : isPaused ? "postponed" : isClosed ? "closed" : "upcoming"}}> {isLive ? "🔴 LIVE NOW" : isPaused ? "⚠️ POSTPONED" : isClosed ? "🏁 SESSION ENDED" : "🕒 UPCOMING"} </span> <small className="timeline-week-marker"> <FaCalendarCheck /> {cls.weekPicker || "Week N/A"} </small> </div> {/* ⏳ CORE REAL-TIME LIVE COUNTDOWN HUB */} {!isLive && !isPaused && !isClosed && cls.targetDateTime && ( <div className="live-countdown-timer-dock"> <span className="countdown-label"></span> <code className="countdown-clock-digits"> {calculateCountdown(cls.targetDateTime)} </code> </div> )} {/* MAIN CARD BODY */} <div className="card-body-details"> <h3 className="subject-core-title"> {cls.classN "Academic View"} </h3> <span className="faculty-tag-title"> {cls.teacherName e || "Official Faculty"} </span> <div className="parameter-data-row"> <p> <span>Active Lesson:</span> {cls.currentLesson || "Not Specified"} </p> </div> <div className="parameter-data-row"> <p> <span>Start Target:</span> {cls.targetDateTime ? new Date(cls.targetDateTime).toLocaleString() : "No Date Set"} </p> </div> {cls.specialNotes && ( <div className="special-instruction-box"> <p>Notice :</p> <span>{cls.specialNotes}</span> </div> )} </div> {/* 📢 LATEST CLASS NOTICE FEED LINK */} {latestNotice && ( <div className="latest-notice-broadcast-banner"> <div className="notice-banner-header"> <FaBullhorn /> <span>Latest Bulletin Board Alert:</span> </div> <p>"{latestNotice.text}"</p> </div> )} {/* 👟 CARD FOOTER ACTION ZONE */} <div className="card-action-footer-matrix"> <button type="button" onClick={() => { const calendarUrl = buildGoogleCalendarUrl(cls); if (calendarUrl !== "#") { window.open(calendarUrl, "_blank", "noopener,noreferrer"); } }} className="google-calendar-anchor-link" title="Sync Reminder to Google Calendar" > <FaGoogle /> Add Reminder </button> {isLive ? ( <Link to="/dashboard" className="action-button-gate live-join-btn"> <FaLock /> Access Dashboard to Join Zoom </Link> ) : ( <div className="disabled-action-flow-wrapper"> {cls.targetDateTime && ( <button disabled className="action-button-gate disabled-btn"> {isPaused ? "Class Session Postponed" : "Room Locked"} </button> )} </div> )} </div> </div> ); }; export default ScheduleCard; 

/* ======================================================== 2026 CYBER PUBLIC TIMETABLE COMPONENT MATRIX ======================================================== */ .public-schedule-card { width: 100%; max-width: 340px; min-height: 460px; 
    // 👈 Base Style: සයිට් එකේ තද නිල් පසුබිම උඩින් කැපිලා පේන ලස්සන Dark Glass Layer එකක් දුන්නා 
    background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 28px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2); display: flex; flex-direction: column; gap: 20px; transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); position: relative; box-sizing: border-box; &:hover { transform: translateY(-5px); border-color: rgba(255, 255, 255, 0.12); box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35); } 
    /* 🔴 1️⃣ 2026 FIX: LIVE NOW - කාඩ් එක පුරාම රෝස/රතු පාට NEON AURA එකක් පැතිරෙන කොටස */ 
    &.pulse-neon-live { border: 1.5px solid #ff2c73 !important; 
        /* Cyber Vivid Rose Color */ // 📍 කාඩ් එක පුරාම ලස්සනට රෝස පාටින් පත්තුවෙලා නිවෙන Radial Neon Aura එකක් දුන්නා background: radial-gradient( circle at 50% 0%, rgba(255, 44, 115, 0.15) 0%, rgba(15, 23, 42, 0.7) 70% ) !important; box-shadow: 0 0 30px rgba(255, 44, 115, 0.25); animation: neonRoseGlow 1.8s infinite alternate ease-in-out; .card-body-details .faculty-tag-title { color: #ff2c73 !important; text-shadow: 0 0 8px rgba(255, 44, 115, 0.4); } } /* ⚠️ POSTPONED STATE */ &.card-postponed { border: 1px solid #f39c12 !important; background: rgba(243, 156, 18, 0.03) !important; box-shadow: 0 10px 30px rgba(243, 156, 18, 0.05); } /* 🏁 SESSION ENDED STATE (අක්‍රීය වුණු පන්ති ලාවට අඳුරු වේ) */ &.card-session-ended { opacity: 0.45; background: rgba(0, 0, 0, 0.3) !important; border-color: rgba(255, 255, 255, 0.02) !important; } /* --- TOP META BAR (Badges) --- */ .card-top-bar-meta { display: flex; justify-content: space-between; align-items: center; width: 100%; .status-tag-pill { padding: 4px 10px; border-radius: 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.5px; &.live { background: rgba(255, 44, 115, 0.12); color: #ff2c73; border: 1px solid rgba(255, 44, 115, 0.2); } &.postponed { background: rgba(243, 156, 18, 0.1); color: #f39c12; border: 1px solid rgba(243, 156, 18, 0.2); } &.closed { background: rgba(255, 255, 255, 0.05); color: #94a3b8; } &.upcoming { background: rgba(37, 99, 235, 0.1); color: #3b82f6; border: 1px solid rgba(37, 99, 235, 0.2); } } .timeline-week-marker { font-size: 0.8rem; color: #64748b; font-weight: 600; display: flex; align-items: center; gap: 6px; } } /* --- REAL-TIME COUNTDOWN HUB --- */ .live-countdown-timer-dock { background: rgba(0, 0, 0, 0.2); padding: 12px 16px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.03); text-align: center; margin-top: 5px; .countdown-clock-digits { font-size: 1.15rem; color: #00f1d1; // Countdown එක පට්ටම ලස්සන Neon Teal පාටින් font-weight: 800; font-family: monospace; text-shadow: 0 0 10px rgba(0, 241, 209, 0.4); } } /* --- MAIN CARD DETAILS TEXT AREA --- */ .card-body-details { display: flex; flex-direction: column; gap: 12px; .subject-core-title { margin: 0; color: #ffffff; // සුදු පාට කළා Dark bg එකට පේන්න font-size: 1.25rem; font-weight: 800; letter-spacing: -0.01em; } .faculty-tag-title { font-size: 0.82rem; font-weight: 700; color: #00f1d1; /* Faculty නම Neon Teal වේ */ text-transform: uppercase; letter-spacing: 0.5px; } // Data rows (Lesson, Start time) .parameter-data-row { display: flex; align-items: center; margin: 0; p { margin: 0; font-size: 0.88rem; color: #cbd5e1; font-weight: 500; display: flex; gap: 6px; span { color: #64748b; /* Active lesson:, Start Target: වචන මැලවී පෙනේ */ font-weight: 600; } } } /* Special Info Alert Box */ .special-instruction-box { background: rgba(241, 196, 15, 0.03); padding: 12px 15px; border-radius: 10px; border-left: 4px solid #f1c40f; border: 1px solid rgba(241, 196, 15, 0.1); border-left: 4px solid #f1c40f; color: #e2e8f0; font-size: 0.85rem; line-height: 1.4; margin-top: 5px; p { margin: 0 0 4px 0; font-weight: 700; color:
#f1c40f; } span { font-weight: 500; } } } /* --- BULLETIN ALERT BANNER --- */ .latest-notice-broadcast-banner { background: rgba(37, 99, 235, 0.04); border: 1px solid rgba(37, 99, 235, 0.1); border-left: 4px solid #2563eb; padding: 12px 15px; border-radius: 0 10px 10px 0; .notice-banner-header { display: flex; align-items: center; gap: 6px; color: #3b82f6; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; } p { margin: 6px 0 0 0; font-size: 0.84rem; color: #93c5fd; font-style: italic; line-height: 1.4; } } /* --- FOOTER ACTION ZONE (Action Buttons) --- */ .card-action-footer-matrix { margin-top: auto; border-top: 1px solid rgba(255, 255, 255, 0.06); padding-top: 15px; display: flex; flex-direction: column; gap: 10px; // Google Calendar Anchor Button .google-calendar-anchor-link { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); color: #94a3b8; padding: 8px; border-radius: 10px; font-size: 0.8rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; &:hover { background: rgba(255, 255, 255, 0.06); color: #ffffff; } } // Active Live Join Button .action-button-gate.live-join-btn { background: linear-gradient(135deg, #ff2c73 0%, #ff416c 100%); color: white !important; text-decoration: none !important; padding: 12px; border-radius: 12px; font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 6px 15px rgba(255, 44, 115, 0.3); transition: all 0.3s ease; &:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(255, 44, 115, 0.5); } } // Locked/Postponed Disabled Button .action-button-gate.disabled-btn { width: 100%; padding: 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); color: #475569; border-radius: 12px; font-weight: 700; font-size: 0.85rem; cursor: not-allowed; } } } /* ======================================================== CYBER DYNAMIC ROSE GLOW ANIMATION ======================================================== */ @keyframes neonRoseGlow { 0% { box-shadow: 0 0 15px rgba(255, 44, 115, 0.15); border-color: rgba(255, 44, 115, 0.4); } 100% { box-shadow: 0 0 32px rgba(255, 44, 115, 0.5); border-color: rgba(255, 44, 115, 1); } } 
