  // 👑 🔐 [THE OFFICIAL GEMINI SDK ENGINE]:
// කිසිම API_URL එකක් නැතිව, ගූගල් නිල SDK එකෙන්ම මතකය රකින සුපිරිම පාලම මචං! [INDEX 4]

const sendMessageToGemini = async (userMessage) => {
  setIsTyping(true);

  try {
    // 1️⃣ .env ෆයිල් එක ඇතුළෙන් උඹේ සැබෑ AQ. Key එක නිවැරදිව කියවා ගනී [INDEX 4]
    const apiKey = import.meta.env.VITE_GEMINI_API_KEY;

    // 2️⃣ 🤖 [THE SDK INITIALIZATION]: උඩින් import කරපු GoogleGenerativeAI එක මෙතැනදී පණ ගන්වයි!
    const genAI = new GoogleGenerativeAI(apiKey);
    const model = genAI.getGenerativeModel({ 
      model: "gemini-1.5-flash",
      systemInstruction: SYSTEM_INSTRUCTION // අපේ සිංහල උපදෙස් වැට මෙතැනට ලොක් කළා මචං [INDEX 4]
    });

    // 3️⃣ පරණ හිස්ට්‍රියම (Context Memory) ගූගල් SDK එකට ගැළපෙන පිරිසිදු ව්‍යුහයට හරවා ගනී [INDEX 4]
    const chatHistoryForSDK = messages.map(msg => ({
      role: msg.role === "user" ? "user" : "model",
      parts: [{ text: msg.text }]
    }));

    // 4️⃣ 🚀 [THE START CHAT ENGINE]: ගූගල් නිල සන්නිවේදන පාලම මතකයත් සමඟ ලයිව් ස්ටාර්ට් කරයි! [INDEX 4]
    const chat = model.startChat({
      history: chatHistoryForSDK
    });

    // ගූගල් සර්වර් එකට මැසේජ් එක ලයිව් යවා විස්තරාත්මක පිළිතුර ලබා ගනී [INDEX 4]
    const result = await chat.sendMessage(userMessage);
    const response = await result.response;
    const botReply = response.text() || "මචං, කරුණාකරලා නැවත ප්‍රශ්නය ටයිප් කරන්න මචං! ⚠️";

    // AI පිළිතුර සජීවීව මතක ලිස්තුවට එකතු කරයි (Append) [INDEX 4]
    setMessages(prev => [...prev, { role: "model", text: botReply }]);
  } catch (error) {
    console.error("Gemini SDK Core Error:", error);
    setMessages(prev => [...prev, { role: "model", text: "මචං, සර්වර් එකත් එක්ක සම්බන්ධ වීමේ දෝෂයක් ආවා! ❌" }]);
  }

  setIsTyping(false);
};






  // "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AQ.Ab8RN6KBKNkrzs_d9ffxK17eef5Yrgm5p-QExl5XV16ddSApBQ",
        // "https://googleapis.com/AQ.Ab8RN6KBKNkrzs_d9ffxK17eef5Yrgm5p-QExl5XV16ddSApBQ",

        //         curl "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AQ.Ab8RN6KBKNkrzs_d9ffxK17eef5Yrgm5p-QExl5XV16ddSApBQ" \
        // -H "Content-Type: application/json" \
        // -X POST \
        // -d '{
        //   "contents": [{
        //     "parts":[{"text": "Explain quantum computing in one sentence."}]
        //   }]
        // }'








/* ඔයාගේ පරණ ශ්‍රිතය (Function) සම්පූර්ණයෙන්ම මකලා, මේ කොටස පේස්ට් කරන්න මචං: */

const sendMessageToGemini = async (userMessage) => {
  setIsTyping(true);

  try {
    // 1️⃣ .env ෆයිල් එක ඇතුළෙන් උඹේ සැබෑ AQ. Key එක නිවැරදිව කියවා ගනී [INDEX 4]
    const apiKey = import.meta.env.VITE_GEMINI_API_KEY;

    // 2️⃣ 🤖 [THE SDK INITIALIZATION]: උඩින් import කරපු GoogleGenerativeAI එක පණ ගන්වයි! [INDEX 4]
    const genAI = new GoogleGenerativeAI(apiKey);
    const model = genAI.getGenerativeModel({ 
      model: "gemini-1.5-flash",
      systemInstruction: SYSTEM_INSTRUCTION // අපේ සිංහල උපදෙස් වැට මෙතැනට ලොක් කළා මචං [INDEX 4]
    });

    // 3️⃣ පරණ හිස්ට්‍රියම (Context Memory) ගූගල් SDK එකට ගැළපෙන පිරිසිදු ව්‍යුහයට හරවා ගනී [INDEX 4]
    const chatHistoryForSDK = messages.map(msg => ({
      role: msg.role === "user" ? "user" : "model",
      parts: [{ text: msg.text }]
    }));

    // 4️⃣ 🚀 [THE START CHAT ENGINE]: ගූගල් නිල සන්නිවේදන පාලම ලයිව් ස්ටාර්ට් කරයි! [INDEX 4]
    const chat = model.startChat({
      history: chatHistoryForSDK
    });

    // ගූගල් නිල සර්වර් එකට මැසේජ් එක ලයිව් යවා විස්තරාත්මක පිළිතුර ලබා ගනී [INDEX 4]
    const result = await chat.sendMessage(userMessage);
    const response = await result.response;
    const botReply = response.text() || "Dude, there was a small server error. Please type the question again, dude!";

    // AI පිළිතුර සජීවීව මතක ලිස්තුවට එකතු කරයි (Append) [INDEX 4]
    setMessages(prev => [...prev, { role: "model", text: botReply }]);
  } catch (error) {
    console.error("Gemini SDK Core Error:", error);
    setMessages(prev => [...prev, { role: "model", text: "Technical connection error occurred!" }]);
  }

  setIsTyping(false);
};